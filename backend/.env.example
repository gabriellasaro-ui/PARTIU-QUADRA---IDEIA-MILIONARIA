# ==========================================================================
# Qadras — variaveis de ambiente do backend
# Copie para `.env` em dev local. Em producao (EasyPanel), preencha os
# mesmos nomes no painel do app.
# ==========================================================================

# --- Conexoes -------------------------------------------------------------
# Em dev: copie este arquivo para `.env` (gitignored) e preencha as URLs.
# Em producao (EasyPanel): use as URLs INTERNAS (mesma subnet) nas Variables
# dos apps — ex.: postgresql+psycopg://USER:PASS@<app>_postgres:5432/<db>
# e redis://default:PASS@<app>_redis:6379. NUNCA coloque credenciais reais
# aqui (este arquivo e versionado).
DATABASE_URL=postgresql+psycopg://qadras:qadras@localhost:5432/qadras
# REDIS_URL=redis://:senha@localhost:6379/0

# --- Seguranca (JWT) ------------------------------------------------------
# Gere com: openssl rand -hex 32  (minimo 32 chars em producao)
JWT_SECRET=troque-por-um-segredo-longo-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---------------------------------------------------------------
# Subdominios dos 3 apps MAIS as origens dos APKs. "*" libera tudo (apenas dev).
#
# NAO ESQUECA AS DUAS ULTIMAS. Dentro do aparelho o Capacitor serve a pagina de
# http://localhost (Android, androidScheme "http") ou capacitor://localhost
# (iOS) — e e ESSA a origem que chega aqui, nao o dominio do site. Sem elas o
# navegador do app bloqueia TODO request, e o sintoma e identico ao de um IP
# errado: "o app nao conecta". Ja custou horas uma vez.
#
# `http://localhost:5177` e o PAINEL DO ADMIN, que roda da maquina de quem
# administra e nao esta hospedado — sem essa origem a triagem de arenas abre
# vazia, sem erro visivel.
CORS_ORIGINS=https://app.qadras.com.br,https://gerente.qadras.com.br,https://admin.qadras.com.br,http://localhost,capacitor://localhost,http://localhost:5177

# --- Verificacao de contato (codigo por e-mail) -----------------------------
# "log"    -> escreve o codigo no log E o devolve na resposta HTTP. So dev.
# "resend" -> envia de verdade. Exige RESEND_API_KEY.
#
# ATENCAO: "log" NAO SOBE em producao — a config recusa iniciar. Ele entrega o
# codigo a quem pedir, o que anula a verificacao inteira.
VERIFICATION_PROVIDER=resend
RESEND_API_KEY=
# Precisa ser de um dominio verificado no provedor, senao ele recusa o envio.
EMAIL_REMETENTE=Qadras <nao-responda@qadras.com.br>

# --- Laco de manutencao ---------------------------------------------------
# De quanto em quanto tempo varrer o banco: confirmar pagamento mock, expirar
# reserva nao paga, concluir partida, convocar pelada, encerrar chat. Ele so
# existe com PAYMENT_PROVIDER=mock — em producao quem faz isso e o Celery beat.
#
# 5s e o padrao, pensado para desenvolvimento. Em VPS pequena vale afrouxar:
# nada aqui tem prazo curto (o mock confirma em 15s, a reserva expira em 15
# min), entao 30s custa um sexto do trabalho sem mudar comportamento nenhum.
#
# Desde a folga no Redis, apenas UM worker varre — antes eram todos.
MANUTENCAO_INTERVALO_S=30

# --- Ambiente --------------------------------------------------------------
# development | production
ENVIRONMENT=production
TIMEZONE=America/Sao_Paulo

# --- Taxas (nao mexer sem alinhar com o frontend) --------------------------
# 9% do jogador POR CIMA do preco da quadra; 3% da arena POR DENTRO do repasse.
PLAYER_FEE_RATE=0.09
ARENA_FEE_RATE=0.03

# --- Push / FCM (Fase 7) -----------------------------------------------------
# provider: mock (padrao, grava em push_logs sem enviar) | fcm (real).
# Com "fcm", informe o caminho do JSON de credenciais da conta de servico
# (Firebase -> Configuracoes do projeto -> Contas de servico) e o Project ID.
# Em producao (EasyPanel) monte o JSON num volume/secret e aponte o caminho.
PUSH_PROVIDER=mock
# FCM_CREDENTIALS_PATH=/var/secrets/firebase.json
# FCM_PROJECT_ID=qadras-app

# --- Google Login -----------------------------------------------------------
# Preencher com o client_id web do OAuth 2.0 (Google Cloud Console).
# Vazio => endpoint /api/auth/google responde 503.
# GOOGLE_CLIENT_ID=

# --- Rate Limiting (Fase 12) ------------------------------------------------
# Desliga os contadores nos testes e em dev local.
# RATE_LIMIT_ENABLED=true
# Storage do slowapi: Redis por padrao (DB 1); memory:// fallback automatico.
# RATE_LIMIT_STORAGE=redis://localhost:6379/1

# --- Telemetria (Fase 12) ---------------------------------------------------
# DEBUG | INFO | WARNING | ERROR — controla a saida de logs estruturados.
# LOG_LEVEL=INFO

# --- Pagamento --------------------------------------------------------------
# "mercadopago" cobra de verdade; "mock" simula e serve apenas para desenvolver
# sem conta de adquirente. Com ENVIRONMENT=production a API RECUSA subir com
# mock: ele confirma cobranca sem dinheiro nenhum entrar.
PAYMENT_PROVIDER=mock
# PAYMENT_MOCK_CONFIRM_SECONDS=15

# --- Mercado Pago (adquirente) ----------------------------------------------
# Access token: painel > Suas integracoes > sua aplicacao > Credenciais.
# Da acesso TOTAL a conta — nunca comite, nunca mande por mensagem. Se vazar,
# gere outro no painel imediatamente.
#
# ATENCAO: nao existe URL de sandbox. O Mercado Pago usa a MESMA API para
# teste e producao, e quem separa e o token:
#     TEST-...      credencial de teste   (cobranca simulada)
#     APP_USR-...   credencial de producao (dinheiro de verdade)
# Em ENVIRONMENT=production a API recusa subir com um token TEST-.
MERCADOPAGO_ACCESS_TOKEN=

# URL publica do callback, enviada em cada cobranca. Deixe vazia para valer
# apenas a URL cadastrada no painel.
# NO SPLIT ISTO DEIXA DE SER OPCIONAL.
#
# Vazia, o Mercado Pago usa so a URL cadastrada no painel. Isso basta em conta
# unica, mas no split a cobranca e criada NA CONTA DA ARENA — depender de
# configuracao de painel para rotear a notificacao e confiar num vinculo que
# nao esta sob seu controle. Preenchida, cada cobranca carrega o proprio
# destino. Sem ela, o Pix e pago e a reserva morre em pending_payment.
MERCADOPAGO_NOTIFICATION_URL=https://api.qadras.com.br/api/payments/webhook/mercadopago

# --- Split de pagamentos 1:1 (marketplace) ----------------------------------
# Cada ARENA conecta a propria conta do Mercado Pago via OAuth; a cobranca sai
# com o token dela e a Qadras retem a comissao (`application_fee`) na mesma
# transacao. O MERCADOPAGO_ACCESS_TOKEN acima e o caminho ANTIGO (conta unica).
#
# Ligue so quando as arenas ja tiverem conectado: com true e sem as
# credenciais abaixo, a API recusa subir em producao.
MERCADOPAGO_SPLIT_ENABLED=false

# Painel > Suas integracoes > sua aplicacao > Credenciais de producao.
# O CLIENT_SECRET troca code por token de QUALQUER vendedor — trate como senha.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Tem de ser IDENTICA a "URL de redirecionamento" cadastrada no painel do MP,
# caractere por caractere e SEM barra final. Divergencia => invalid_grant na
# troca do code, e a arena nunca conecta.
MERCADOPAGO_REDIRECT_URI=https://api.qadras.com.br/api/mercadopago/oauth/callback

# Para onde devolver o dono da arena depois de autorizar. Vazia => o callback
# responde JSON (util em curl e em teste).
# MERCADOPAGO_PANEL_RETURN_URL=https://gerente.qadras.com.br/pagamentos

# Teto da taxa do Mercado Pago que a QADRAS banca; o que exceder fica com a
# arena. Com 0.0099: no Pix a taxa fica abaixo do teto e a arena recebe os 97%
# cheios; no cartao o excedente e dela, e a margem da Qadras nao desaba.
# Parametro COMERCIAL — mexer aqui muda quanto voce ganha por reserva.
MERCADOPAGO_FEE_ABSORBED_CAP=0.0099

# Taxa presumida de uma arena enquanto a real nao foi medida. A verdadeira vem
# no `fee_details` da resposta do pagamento e e gravada por conexao.
MERCADOPAGO_DEFAULT_FEE_RATE=0.0099

# Dias antes do vencimento em que a task diaria renova o token do vendedor. O
# MP da 180 dias e NAO avisa: sem renovacao, seis meses depois toda cobranca
# da arena falha de uma vez.
MERCADOPAGO_REFRESH_DAYS_BEFORE=15

# --- Webhook de pagamento ---------------------------------------------------
# Assinatura secreta do webhook. Sem ela, qualquer um que conheca o id do
# pagamento POSTa um callback e confirma a reserva sem pagar.
#
# NAO invente este valor: ele e GERADO pelo Mercado Pago. Painel > Suas
# integracoes > sua aplicacao > Webhooks > Configurar notificacao. Copie a
# "assinatura secreta" de la para ca.
#
# URL a cadastrar no painel:
#     https://SEU-DOMINIO/api/payments/webhook/mercadopago
# Eventos: "Pagamentos" (payment).
PAYMENT_WEBHOOK_SECRET=

# --- Reset de senha do admin ------------------------------------------------
# Defina "true" UMA VEZ para regenerar a senha do admin. A nova senha aparece
# nos logs do container. Depois, REMOVA esta variavel.
# RESET_ADMIN_PASSWORD=true
